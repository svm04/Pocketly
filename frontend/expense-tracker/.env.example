# Copy this file to .env and fill in real values for local overrides.
# In Vercel, set VITE_API_BASE_URL in the project's Environment Variables
# settings instead of committing a .env file.

# The deployed backend's URL (e.g. https://pocketly-api.onrender.com).
# Leave unset for local dev — it falls back to http://localhost:8000.
VITE_API_BASE_URL=
