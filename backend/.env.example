# Copy this file to .env and fill in real values. Never commit the real
# .env — it's already excluded via .gitignore.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=

# Any long random string — used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the server listens on locally. Hosting providers like Render set
# their own PORT env var automatically and this is ignored there.
PORT=8000

# The deployed frontend's URL (e.g. https://pocketly.vercel.app). Used for
# CORS and for building password-reset links. Leave blank / use
# http://localhost:5173 for local development.
CLIENT_URL=http://localhost:5173

# Optional — real email sending for password resets, via Brevo's REST API
# (HTTPS, not SMTP — Render's free tier blocks outbound SMTP ports, so a
# plain nodemailer/SMTP setup won't work there). Leave BREVO_API_KEY/
# EMAIL_FROM blank to fall back to logging the reset link to the console /
# API response instead of sending an email.
# Get an API key: Brevo dashboard -> Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=
# Must be a sender address verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM=
EMAIL_FROM_NAME=Pocketly
