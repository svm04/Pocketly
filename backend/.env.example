# Copy this file to .env and fill in real values. Never commit the real
# .env — it's already excluded via .gitignore.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=

# Any long random string — used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the server listens on locally. Hosting providers like Render set
# their own PORT env var automatically and this is ignored there.
PORT=8000

# The deployed frontend's URL (e.g. https://pocketly.vercel.app). Used for
# CORS and for building password-reset links. Leave blank / use
# http://localhost:5173 for local development.
CLIENT_URL=http://localhost:5173

# Optional — real email sending for password resets. Leave all four blank
# to fall back to logging the reset link to the console / API response
# instead of sending an email.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
